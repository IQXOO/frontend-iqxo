# Backend secret environment variables (DO NOT commit real secrets)
# These values belong on your server / CI / deployment environment only.

# OpenAI secret key (server-side only)
OPENAI_API_KEY=your-openai-secret

# Any project-wide API keys used by backend workers
API_KEY=your-project-api-key

# Supabase service_role / secret key (server-side only)
SUPABASE_SECRET_KEY=your-supabase-secret
