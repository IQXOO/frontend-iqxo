## Frontend public environment variables (Vite)
# Only include public-safe values. DO NOT put secrets here.

# Supabase (frontend-safe -- anon key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key-placeholder

# Backend API for server-side proxied requests (OpenAI, image/voice analysis)
VITE_BACKEND_API=https://your-backend.example.com

# Stripe public identifiers / links
VITE_STRIPE_MONTHLY_PRICE_ID=price_example_monthly
VITE_STRIPE_YEARLY_PRICE_ID=price_example_yearly
VITE_STRIPE_MONTHLY_LINK=https://buy.stripe.com/example_monthly
VITE_STRIPE_YEARLY_LINK=https://buy.stripe.com/example_yearly
